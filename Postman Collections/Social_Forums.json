    {
      "name": "API Metadata (OPTIONS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Endpoint /forums allows GET and POST methods\", function () {",
              "    pm.expect(pm.response.json().endpoints[\"/forums\"].allowedMethods).to.include(\"GET\");",
              "    pm.expect(pm.response.json().endpoints[\"/forums\"].allowedMethods).to.include(\"POST\");",
              "});",
              "",
              "pm.test(\"Endpoint /forums/{forumId} allows GET, PUT, and DELETE methods\", function () {",
              "    pm.expect(pm.response.json().endpoints[\"/forums/{forumId}\"].allowedMethods).to.include(\"GET\");",
              "    pm.expect(pm.response.json().endpoints[\"/forums/{forumId}\"].allowedMethods).to.include(\"PUT\");",
              "    pm.expect(pm.response.json().endpoints[\"/forums/{forumId}\"].allowedMethods).to.include(\"DELETE\");",
              "});",
              "",
              "pm.test(\"Endpoint /forums/{forumId}/topics POST payload has required fields\", function () {",
              "    pm.expect(pm.response.json().endpoints[\"/forums/{forumId}/topics\"].acceptedPayloads.POST).to.have.property(\"title\");",
              "    pm.expect(pm.response.json().endpoints[\"/forums/{forumId}/topics\"].acceptedPayloads.POST).to.have.property(\"author\");",
              "});",
              "",
              "pm.test(\"Endpoint /replies/{replyId} allows DELETE method\", function () {",
              "    pm.expect(pm.response.json().endpoints[\"/replies/{replyId}\"].allowedMethods).to.include(\"DELETE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
